{
  "name": "sistema-bibliotecario",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:student",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "dev:student": "vite --host 0.0.0.0 --port 5173",
    "dev:admin": "VITE_APP_SITE=admin vite --host 0.0.0.0 --port 5174",
    "build:student": "VITE_APP_SITE=student tsc -b && VITE_APP_SITE=student vite build --outDir dist-student",
    "build:admin": "VITE_APP_SITE=admin tsc -b && VITE_APP_SITE=admin vite build --outDir dist-admin"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@hookform/resolvers": "^3.10.0",
    "lucide-react": "^0.468.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vitest": "^2.1.8"
  }
}
