# Usado quando o backend é iniciado diretamente no host.
ENVIRONMENT=development
# SQLite persistente por padrão em ../data/libris.db
DATABASE_URL=
LIBRIS_DATA_DIR=
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
LIBRIS_SETUP_KEY=replace-with-a-random-one-time-setup-key-at-least-24-characters
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SQL_ECHO=false
