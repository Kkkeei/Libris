# Copie para .env. Use segredos únicos no ambiente local; nunca faça commit deste arquivo.
ENVIRONMENT=development

# Libris usa SQLite persistente. O caminho padrão é ./data/libris.db.
# Para mudar a localização, defina LIBRIS_DATA_DIR=/caminho/privado/dos/dados
DATABASE_URL=
LIBRIS_DATA_DIR=
SQL_ECHO=false

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# Chave temporária para criar a primeira conta administrativa. Remova após o setup.
LIBRIS_SETUP_KEY=replace-with-a-random-one-time-setup-key-at-least-24-characters

ACCESS_TOKEN_MINUTES=480
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Bibliotecária

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VITE_API_BASE_URL=http://localhost:8000/api/v1
# URL pública do site administrativo, exibida no portal do aluno.
VITE_ADMIN_SITE_URL=http://localhost:5174
