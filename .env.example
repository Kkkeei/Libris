# Copie para .env. Estes valores são apenas para desenvolvimento local.
ENVIRONMENT=development
POSTGRES_DB=libris
POSTGRES_USER=libris
POSTGRES_PASSWORD=change-this-local-development-password
POSTGRES_PORT=5433
API_PORT=8000
SQL_ECHO=false

# URL para execução local do backend fora do Docker.
DATABASE_URL=postgresql+psycopg://libris:change-this-local-development-password@localhost:5433/libris
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# URL pública usada pelo frontend no navegador.
VITE_API_BASE_URL=http://localhost:8000/api/v1
